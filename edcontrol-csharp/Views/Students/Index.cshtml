@model List<EdControl.Models.Student>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Студенты";
}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0 fw-bold">Студенты</h4>
        <p class="text-muted mb-0">Список обучающихся</p>
    </div>
    <a href="/Students/Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Добавить студента</a>
</div>
<div class="p-4">
    <form class="mb-3 d-flex gap-2">
        <select name="groupId" class="form-select" style="max-width:220px" onchange="this.form.submit()">
            <option value="">Все группы</option>
            @foreach (var item in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Groups)
            {
                <option value="@item.Value" selected="@(item.Selected)">@item.Text</option>
            }
        </select>
    </form>
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ФИО</th>
                        <th>Группа</th>
                        <th>№ студ. билета</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@s.FullName</td>
                            <td>@s.Group?.Name</td>
                            <td>@(s.StudentNumber ?? "—")</td>
                            <td>
                                <a href="/Students/Edit/@s.Id" class="btn btn-sm btn-outline-secondary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="/Students/Delete/@s.Id" style="display:inline"
                                      onsubmit="return confirm('Удалить студента?')">
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
