@{
    Layout = "_Layout";
    ViewData["Title"] = "Новый студент";
}
<div class="page-header"><h4 class="mb-0 fw-bold">Новый студент</h4></div>
<div class="p-4">
    <div class="card border-0 shadow-sm" style="max-width:500px">
        <div class="card-body p-4">
            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Фамилия</label>
                    <input name="LastName" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Имя</label>
                    <input name="FirstName" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Отчество</label>
                    <input name="MiddleName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Группа</label>
                    <select name="GroupId" class="form-select" required>
                        @foreach (var item in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Groups)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold">Номер студенческого билета</label>
                    <input name="StudentNumber" class="form-control" />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    <a href="/Students" class="btn btn-outline-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>
