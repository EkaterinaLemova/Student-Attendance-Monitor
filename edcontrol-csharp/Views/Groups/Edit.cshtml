@model EdControl.Models.Group
@{
    Layout = "_Layout";
    ViewData["Title"] = "Редактировать группу";
}
<div class="page-header">
    <h4 class="mb-0 fw-bold">Редактировать группу</h4>
</div>
<div class="p-4">
    <div class="card border-0 shadow-sm" style="max-width:500px">
        <div class="card-body p-4">
            <form method="post">
                <input type="hidden" name="Id" value="@Model.Id" />
                <div class="mb-3">
                    <label class="form-label fw-semibold">Название группы</label>
                    <input name="Name" class="form-control" value="@Model.Name" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Специальность</label>
                    <input name="Specialty" class="form-control" value="@Model.Specialty" required />
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold">Год набора</label>
                    <input name="Year" type="number" class="form-control" value="@Model.Year" required />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    <a href="/Groups" class="btn btn-outline-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>
