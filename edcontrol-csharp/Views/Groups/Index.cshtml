@model List<EdControl.Models.Group>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Группы";
}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0 fw-bold">Группы</h4>
        <p class="text-muted mb-0">Управление учебными группами</p>
    </div>
    <a href="/Groups/Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Добавить группу</a>
</div>
<div class="p-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Название</th>
                        <th>Специальность</th>
                        <th>Год набора</th>
                        <th>Студентов</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@g.Name</td>
                            <td>@g.Specialty</td>
                            <td>@g.Year</td>
                            <td><span class="badge bg-primary">@g.Students.Count</span></td>
                            <td>
                                <a href="/Groups/Edit/@g.Id" class="btn btn-sm btn-outline-secondary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="/Groups/Delete/@g.Id" style="display:inline"
                                      onsubmit="return confirm('Удалить группу @g.Name?')">
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
