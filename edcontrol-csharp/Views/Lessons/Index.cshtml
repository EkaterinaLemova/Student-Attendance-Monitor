@model List<EdControl.Models.Lesson>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Занятия";
}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0 fw-bold">Занятия</h4>
        <p class="text-muted mb-0">Учебные занятия и посещаемость</p>
    </div>
    <a href="/Lessons/Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Добавить занятие</a>
</div>
<div class="p-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr><th>Дата</th><th>Предмет</th><th>Группа</th><th>Тема</th><th>Тип</th><th>Действия</th></tr>
                </thead>
                <tbody>
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td>@l.Date.ToString("dd.MM.yyyy")</td>
                            <td>@l.Subject?.Name</td>
                            <td>@l.Group?.Name</td>
                            <td>@(l.Topic ?? "—")</td>
                            <td>
                                @switch (l.LessonType)
                                {
                                    case "lecture": <span class="badge bg-primary">Лекция</span> break;
                                    case "practice": <span class="badge bg-success">Практика</span> break;
                                    case "lab": <span class="badge bg-warning text-dark">Лаб. работа</span> break;
                                    default: <span class="badge bg-secondary">@l.LessonType</span> break;
                                }
                            </td>
                            <td>
                                <a href="/Lessons/Attendance/@l.Id" class="btn btn-sm btn-outline-primary me-1" title="Посещаемость">
                                    <i class="bi bi-check2-square"></i>
                                </a>
                                <a href="/Lessons/Edit/@l.Id" class="btn btn-sm btn-outline-secondary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="/Lessons/Delete/@l.Id" style="display:inline" onsubmit="return confirm('Удалить занятие?')">
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
