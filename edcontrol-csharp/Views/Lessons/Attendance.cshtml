@model EdControl.Models.Lesson
@{
    Layout = "_Layout";
    ViewData["Title"] = "Посещаемость";
    var students = Model.Group?.Students.ToList() ?? new List<EdControl.Models.Student>();
    var records = Model.AttendanceRecords.ToList();
}
<div class="page-header">
    <h4 class="mb-0 fw-bold">Посещаемость</h4>
    <p class="text-muted mb-0">@Model.Subject?.Name — @Model.Group?.Name — @Model.Date.ToString("dd.MM.yyyy")</p>
</div>
<div class="p-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <form method="post" action="/Lessons/SaveAttendance">
                <input type="hidden" name="lessonId" value="@Model.Id" />
                <table class="table">
                    <thead class="table-light">
                        <tr>
                            <th>Студент</th>
                            <th>Статус</th>
                            <th>Примечание</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < students.Count; i++)
                        {
                            var student = students[i];
                            var record = records.FirstOrDefault(r => r.StudentId == student.Id);
                            var status = record?.Status ?? "present";
                            <tr>
                                <td class="fw-semibold align-middle">@student.FullName</td>
                                <td>
                                    <input type="hidden" name="studentIds" value="@student.Id" />
                                    <select name="statuses" class="form-select form-select-sm" style="width:160px">
                                        <option value="present" @(status == "present" ? "selected" : "")>Присутствует</option>
                                        <option value="absent" @(status == "absent" ? "selected" : "")>Отсутствует</option>
                                        <option value="late" @(status == "late" ? "selected" : "")>Опоздал</option>
                                        <option value="excused" @(status == "excused" ? "selected" : "")>Уважительная</option>
                                    </select>
                                </td>
                                <td>
                                    <input name="notes" class="form-control form-control-sm" value="@record?.Note" placeholder="Примечание" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    <a href="/Lessons" class="btn btn-outline-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>
